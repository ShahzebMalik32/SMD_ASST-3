<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top bar: back arrow + (UI only) avatars and Invite -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_white"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <Button
            android:id="@+id/tvInvite"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_button_blue"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/invite"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/rowAvatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@id/tvInvite"
            android:orientation="horizontal">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="#E3E6FC"
                android:gravity="center"
                android:text="JD"
                android:textColor="#3B3FA8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-8dp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="#D8F5E6"
                android:gravity="center"
                android:text="AL"
                android:textColor="#1F7A4D"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="-8dp"
                android:background="@drawable/bg_avatar"
                android:backgroundTint="#FADADD"
                android:gravity="center"
                android:text="MK"
                android:textColor="#B3261E"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Header: selected project's tag and name -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/tvProjectTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_purple"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:textColor="@color/chip_purple_text"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvProjectName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@color/screen_background"
        app:tabIndicatorColor="@color/accent_blue"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp"
        app:tabSelectedTextColor="@color/accent_blue"
        app:tabTextAppearance="@style/TabText"
        app:tabTextColor="@color/text_secondary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
