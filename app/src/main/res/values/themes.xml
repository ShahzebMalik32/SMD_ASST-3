<resources>
    <style name="Theme.TaskFlow" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryDark">@color/navy</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="TabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">13sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
